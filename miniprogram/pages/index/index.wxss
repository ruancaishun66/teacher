.page {
  min-height: 100vh;
  padding: 56rpx 40rpx 60rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 20% 0%, #fff6e2 0%, rgba(255, 246, 226, 0) 46%),
    linear-gradient(180deg, #fbf4e4 0%, #eef7f4 100%);
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 52rpx;
}

.mark {
  width: 104rpx;
  height: 104rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #1a4c59;
}

.sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #8a7a62;
}

.hint {
  margin-bottom: 36rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6d7f80;
}

.entry {
  margin: 0 0 22rpx;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 247, 0.92);
  border: 1rpx solid rgba(32, 86, 96, 0.12);
  box-shadow: 0 16rpx 36rpx -30rpx rgba(23, 75, 86, 0.55);
  color: #234c57;
  font-size: 30rpx;
  font-weight: 600;
  text-align: left;
  line-height: 1.4;
}

.entry::after {
  border: none;
}

.entry.primary {
  background: linear-gradient(120deg, #c94f36, #e2764f);
  color: #fff9f0;
  border-color: rgba(160, 60, 38, 0.35);
}

.entry.ghost {
  background: transparent;
  box-shadow: none;
  color: #5c7477;
}

.foot {
  margin-top: 34rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #8b9a99;
}
